{
  "web": {
    "branches": ["feature/catalog-ui"],
    "paths": ["index.html", "event.html", "app.js", "styles.css", "discover.*", "organiser.*", "assets/*", "tests/web/*"]
  },
  "data": {
    "branches": ["feature/catalog-data"],
    "paths": ["supabase/*", "api/*", "scripts/import-*", "tests/data/*", "venues.js", "data.js", "package.json", "package-lock.json", "requirements.txt", "pyproject.toml", "uv.lock", ".env.example", ".gitignore", "vercel.json", "Dockerfile", "compose.yaml"]
  },
  "agent": {
    "branches": ["feature/discovery-agent"],
    "paths": ["agent/*", "tests/agent/*"]
  },
  "coordination": {
    "branches": ["t3/hola", "chore/coordination"],
    "paths": ["README.md", "AGENTS.md", "docs/*", "coordination/*", "scripts/check_scope.py", ".github/*", ".cursor/rules/*", "LICENSE", "LICENSE.md"]
  }
}
